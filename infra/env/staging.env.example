# Staging. Se copiază în /srv/ama/env/staging.env (mod 600, în afara repo-ului) și se completează.
# Parolele și cheile: valori hexazecimale generate cu `openssl rand -hex 24` (fără caractere speciale: intră în adrese URL).
AMA_ENV=staging
AMA_BASE_URL=https://staging.example.com
AMA_INFRA_DIR=/srv/ama/repo/infra
AMA_ENV_DIR=/srv/ama/env
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
AMA_OWNER_DB_PASSWORD=CHANGE_ME
AMA_APP_DB_PASSWORD=CHANGE_ME
AMA_BACKUP_DB_PASSWORD=CHANGE_ME
AMA_SECRET_KEY=CHANGE_ME_MIN_32_CHARS
AMA_MASTER_KEY=CHANGE_ME_MIN_32_CHARS
# Staging nu apelează panoul; jetonul poate rămâne gol
AMA_DEPLOY_TOKEN=

# Furnizorii de modele din catalogul G-pool (docs/specs/G-pool.md), cu numele EXACTE din
# app/gateway/catalog.py (PROVIDER_SECRETS). Gol = furnizor dezactivat automat. Alternativ, în seif:
# `python -m app.gateway.seif pune NUME`. Verificare: `python -m app.gateway.verifica_furnizori`.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=
NVIDIA_NIM_API_KEY_B=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
KILO_API_KEY=
LLM7_API_KEY=
ZAI_API_KEY=
OLLAMA_API_KEY=
SEALION_API_KEY=
# Stock foto și video (F-idee): goale = Wikimedia Commons, fără cheie. AMA_STOCK alege explicit.
PEXELS_API_KEY=
PIXABAY_API_KEY=
