# Staging. Se copiază în /srv/ama/env/staging.env (mod 600, în afara repo-ului) și se completează.
# Parolele și cheile: valori hexazecimale generate cu `openssl rand -hex 24` (fără caractere speciale: intră în adrese URL).
AMA_ENV=staging
AMA_BASE_URL=https://staging.example.com
AMA_INFRA_DIR=/srv/ama/repo/infra
AMA_ENV_DIR=/srv/ama/env
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
AMA_OWNER_DB_PASSWORD=CHANGE_ME
AMA_APP_DB_PASSWORD=CHANGE_ME
AMA_BACKUP_DB_PASSWORD=CHANGE_ME
AMA_SECRET_KEY=CHANGE_ME_MIN_32_CHARS
AMA_MASTER_KEY=CHANGE_ME_MIN_32_CHARS
# Staging nu apelează panoul; jetonul poate rămâne gol
AMA_DEPLOY_TOKEN=
