# Producție. Se copiază în /srv/ama/env/production.env (mod 600, în afara repo-ului) și se completează.
# Valorile trebuie să difere de cele din staging. Parole: `openssl rand -hex 24`.
AMA_ENV=prod
AMA_BASE_URL=https://app.example.com
AMA_INFRA_DIR=/srv/ama/repo/infra
AMA_ENV_DIR=/srv/ama/env
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
AMA_OWNER_DB_PASSWORD=CHANGE_ME
AMA_APP_DB_PASSWORD=CHANGE_ME
AMA_BACKUP_DB_PASSWORD=CHANGE_ME
AMA_SECRET_KEY=CHANGE_ME_MIN_32_CHARS
AMA_MASTER_KEY=CHANGE_ME_MIN_32_CHARS
# Același jeton ca în edge.env (AMA_DEPLOY_TOKEN), min. 32 de caractere
AMA_DEPLOY_TOKEN=CHANGE_ME_MIN_32_CHARS
UVICORN_WORKERS=2
# Notificări push (docs/specs/F1.7.md): `uv run python scripts/genereaza_vapid.py`; goale = dezactivate
AMA_VAPID_PUBLIC_KEY=
AMA_VAPID_PRIVATE_KEY=
AMA_VAPID_SUBJECT=mailto:adresa-ta@exemplu.ro
# Telegram (docs/specs/F1.10.md): jetonul de la @BotFather, id-ul conversației tale, secretul webhook-ului
# (16–256 de caractere A-Za-z0-9_-). Apoi, o dată: python -m app.connectors.telegram.cli seteaza-webhook --url …
AMA_TELEGRAM_BOT_TOKEN=
AMA_TELEGRAM_CHAT_ID=
AMA_TELEGRAM_WEBHOOK_SECRET=
# Backup (docs/specs/F1.9.md)
AMA_BACKUP_DEST=externa:ama-backup/productie
# Cheile PUBLICE age, separate prin virgulă: cheia proprietarului (păstrată offline) + cheia de verificare (pe server)
AMA_BACKUP_AGE_RECIPIENTS=age1CHANGE_ME_CHEIA_PROPRIETARULUI,age1CHANGE_ME_CHEIA_DE_VERIFICARE
# Opțional: comandă care primește rezultatul JSON pe stdin
AMA_BACKUP_REPORT_CMD=
AMA_BACKUP_HOUR=3
AMA_RESTORE_TEST_WEEKDAY=6

# Furnizorii de modele din catalogul G-pool (docs/specs/G-pool.md), cu numele EXACTE din
# app/gateway/catalog.py (PROVIDER_SECRETS). Gol = furnizor dezactivat automat. Alternativ, în seif:
# `python -m app.gateway.seif pune NUME`. Verificare: `python -m app.gateway.verifica_furnizori`.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=
NVIDIA_NIM_API_KEY_B=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
KILO_API_KEY=
LLM7_API_KEY=
ZAI_API_KEY=
OLLAMA_API_KEY=
SEALION_API_KEY=
# Stock foto și video (F-idee): goale = Wikimedia Commons, fără cheie. AMA_STOCK alege explicit.
PEXELS_API_KEY=
PIXABAY_API_KEY=
