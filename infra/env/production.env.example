# Producție. Se copiază în /srv/ama/env/production.env (mod 600, în afara repo-ului) și se completează.
# Valorile trebuie să difere de cele din staging. Parole: `openssl rand -hex 24`.
AMA_ENV=prod
AMA_BASE_URL=https://app.example.com
AMA_INFRA_DIR=/srv/ama/repo/infra
AMA_ENV_DIR=/srv/ama/env
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
AMA_OWNER_DB_PASSWORD=CHANGE_ME
AMA_APP_DB_PASSWORD=CHANGE_ME
AMA_BACKUP_DB_PASSWORD=CHANGE_ME
AMA_SECRET_KEY=CHANGE_ME_MIN_32_CHARS
AMA_MASTER_KEY=CHANGE_ME_MIN_32_CHARS
# Același jeton ca în edge.env (AMA_DEPLOY_TOKEN), min. 32 de caractere
AMA_DEPLOY_TOKEN=CHANGE_ME_MIN_32_CHARS
UVICORN_WORKERS=2
# Backup (docs/specs/F1.9.md)
AMA_BACKUP_DEST=externa:ama-backup/productie
# Cheile PUBLICE age, separate prin virgulă: cheia proprietarului (păstrată offline) + cheia de verificare (pe server)
AMA_BACKUP_AGE_RECIPIENTS=age1CHANGE_ME_CHEIA_PROPRIETARULUI,age1CHANGE_ME_CHEIA_DE_VERIFICARE
# Opțional: comandă care primește rezultatul JSON pe stdin
AMA_BACKUP_REPORT_CMD=
AMA_BACKUP_HOUR=3
AMA_RESTORE_TEST_WEEKDAY=6
