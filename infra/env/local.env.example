# Modul local (docs/runbooks/rulare-locala.md). `make local-up` copiază fișierul în infra/env/local.env (ignorat de
# git) și înlocuiește singur fiecare GENEREAZA_LA_PORNIRE cu o valoare aleatoare. Nu pune aici date reale.
POSTGRES_SUPERUSER_PASSWORD=GENEREAZA_LA_PORNIRE
AMA_OWNER_DB_PASSWORD=GENEREAZA_LA_PORNIRE
AMA_APP_DB_PASSWORD=GENEREAZA_LA_PORNIRE
AMA_BACKUP_DB_PASSWORD=GENEREAZA_LA_PORNIRE
AMA_SECRET_KEY=GENEREAZA_LA_PORNIRE
AMA_MASTER_KEY=GENEREAZA_LA_PORNIRE
# Contul de proprietar creat de popularea demo (parola: generată; o vezi în infra/env/local.env).
AMA_DEMO_EMAIL=admin@local.test
AMA_DEMO_PAROLA=GENEREAZA_LA_PORNIRE
# Singura cheie LLM, opțională (https://openrouter.ai, modele gratuite). Goală = mod simulat.
AMA_CHEIE_OPENROUTER=

# Furnizorii de modele din catalogul G-pool (docs/specs/G-pool.md), cu numele EXACTE din
# app/gateway/catalog.py (PROVIDER_SECRETS). Gol = furnizor dezactivat automat. Alternativ, în seif:
# `python -m app.gateway.seif pune NUME`. Verificare: `python -m app.gateway.verifica_furnizori`.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=
NVIDIA_NIM_API_KEY_B=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
KILO_API_KEY=
LLM7_API_KEY=
ZAI_API_KEY=
OLLAMA_API_KEY=
SEALION_API_KEY=
# Stock foto și video (F-idee): goale = Wikimedia Commons, fără cheie. AMA_STOCK alege explicit.
PEXELS_API_KEY=
PIXABAY_API_KEY=
