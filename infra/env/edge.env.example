# Marginea serverului (proxy + deployer). Se copiază în /srv/ama/env/edge.env (mod 600).
AMA_INFRA_DIR=/srv/ama/repo/infra
AMA_ENV_DIR=/srv/ama/env
# Socketul Docker fără root al utilizatorului `ama` (id-ul se vede cu `id -u ama`)
DOCKER_SOCK=/run/user/1001/docker.sock
AMA_DOMAIN_SITE=example.com
AMA_DOMAIN_APP=app.example.com
AMA_DOMAIN_MEDIA=media.example.com
AMA_DOMAIN_STAGING=staging.example.com
AMA_ACME_EMAIL=ops@example.com
AMA_STAGING_BASIC_USER=ama
# Rezultatul comenzii `docker run --rm caddy:2-alpine caddy hash-password`; între ghilimele simple (conține $)
AMA_STAGING_BASIC_HASH='CHANGE_ME_HASH_BCRYPT'
# Deployer
AMA_DEPLOYER_REPO=ghcr.io/proprietar/ama
AMA_DEPLOYER_STAGING_TAG=main
# Pentru depozit privat GHCR: utilizator + token cu drept doar de citire pachete; gol pentru pachet public
AMA_DEPLOYER_REGISTRY_USER=
AMA_DEPLOYER_REGISTRY_TOKEN=
# Același jeton ca în production.env, min. 32 de caractere
AMA_DEPLOY_TOKEN=CHANGE_ME_MIN_32_CHARS
